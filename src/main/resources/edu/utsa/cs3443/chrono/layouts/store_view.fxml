<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.chrono.store_viewController">
   <children>
      <VBox prefHeight="400.0" prefWidth="447.0" spacing="25.0">
         <children>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Themes" />
            <VBox spacing="12.0">
               <children>
                  <StackPane fx:id="redTheme" prefHeight="70.0" style="-fx-background-color: #4A1C1C; -fx-background-radius: 10;">
                     <children>
                        <Label style="-fx-text-fill: white;" text="Red - 200 Coins" />
                        <Button fx:id="redThemeButton" mnemonicParsing="false" onAction="#buyRed" opacity="0.0" prefHeight="57.0" prefWidth="401.0" />
                     </children>
                  </StackPane>
                  <StackPane fx:id="greenTheme" prefHeight="70.0" style="-fx-background-color: #22332D; -fx-background-radius: 10;">
                     <children>
                        <Label style="-fx-text-fill: white;" text="Green - 200 Coins" />
                        <Button fx:id="greenThemeButton" mnemonicParsing="false" opacity="0.0" prefHeight="57.0" prefWidth="401.0" />
                     </children>
                  </StackPane>
                  <StackPane fx:id="purpleTheme" prefHeight="70.0" style="-fx-background-color: #342544; -fx-background-radius: 10;">
