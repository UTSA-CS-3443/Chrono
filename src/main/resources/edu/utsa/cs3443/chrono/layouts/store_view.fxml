                     </children>
                  </StackPane>
                  <StackPane fx:id="orangeTheme" prefHeight="70.0" style="-fx-background-color: #5A3B10; -fx-background-radius: 10;">
                     <children>
                        <Label style="-fx-text-fill: white;" text="Orange - 200 Coins" />
                        <Button fx:id="orangeThemeButton" mnemonicParsing="false" opacity="0.0" prefHeight="57.0" prefWidth="401.0" />
                     </children>
                  </StackPane>
               </children>
            </VBox>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Cosmetics" />
            <TilePane hgap="10" prefColumns="8" vgap="10">
               <children>
                  <StackPane fx:id="cosmetic1" prefHeight="80" prefWidth="80" style="-fx-background-color: #2E2E2E;">
                     <children>
                        <Label style="-fx-text-fill: white;" text="100 Coins" />
                        <Button fx:id="cosmetic1Button" mnemonicParsing="false" opacity="0.0" prefHeight="98.0" prefWidth="117.0" />
                     </children>
                  </StackPane>
                  <StackPane fx:id="cosmetic2" prefHeight="80" prefWidth="80" style="-fx-background-color: #2E2E2E;">
                     <children>
                        <Label style="-fx-text-fill: white;" text="100 Coins" />
                        <Button fx:id="cosmetic2Button" mnemonicParsing="false" opacity="0.0" prefHeight="98.0" prefWidth="117.0" />
                     </children>
                  </StackPane>
                  <StackPane fx:id="cosmetic3" prefHeight="80" prefWidth="80" style="-fx-background-color: #2E2E2E;">
                     <children>
                        <Label style="-fx-text-fill: white;" text="100 Coins" />
                        <Button fx:id="cosmetic3Button" mnemonicParsing="false" opacity="0.0" prefHeight="98.0" prefWidth="117.0" />
                     </children>
                  </StackPane>
               </children>
            </TilePane>
         </children>
      </VBox>
      <VBox fx:id="dailyBackground" prefHeight="400.0" prefWidth="245.0" spacing="20.0" style="-fx-background-color: #AFB5C5;">
