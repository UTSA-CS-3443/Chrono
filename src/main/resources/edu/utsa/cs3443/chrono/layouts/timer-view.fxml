<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.chrono.TimerController">
   <children>
      <HBox alignment="CENTER" layoutX="130.0" layoutY="166.0" prefHeight="100.0" prefWidth="333.0" AnchorPane.leftAnchor="100.0" AnchorPane.rightAnchor="100.0">
         <children>
            <Button fx:id="plusSecondsButton" mnemonicParsing="false" onAction="#plusSeconds" prefHeight="25.0" prefWidth="45.0" text="+5s">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="minusSecondsButton" mnemonicParsing="false" onAction="#minusSeconds" prefHeight="25.0" prefWidth="45.0" text="-5s">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="plusMinutesButton" mnemonicParsing="false" onAction="#plusMinutes" prefHeight="25.0" prefWidth="45.0" text="+5m">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="minusMinutesButton" mnemonicParsing="false" onAction="#minusMinutes" prefHeight="25.0" prefWidth="45.0" text="-5m">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="plusHoursButton" mnemonicParsing="false" onAction="#plusHours" prefHeight="25.0" prefWidth="45.0" text="+1hr">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="minusHoursButton" mnemonicParsing="false" onAction="#minusHours" prefHeight="25.0" prefWidth="45.0" text="-1hr" />
         </children>
      </HBox>
      <HBox alignment="CENTER" layoutX="129.0" layoutY="266.0" prefHeight="100.0" prefWidth="329.0" AnchorPane.leftAnchor="130.0" AnchorPane.rightAnchor="130.0">
         <children>
            <Button mnemonicParsing="false" onAction="#startTimer" prefHeight="25.0" prefWidth="60.0" text="Start">
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </Button>
            <Button mnemonicParsing="false" onAction="#pauseTimer" prefHeight="25.0" prefWidth="60.0" text="Pause">
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </Button>
            <Button minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#clearTimer" prefHeight="25.0" prefWidth="60.0" text="Clear" />
         </children>
      </HBox>
      <Label fx:id="timerText" alignment="CENTER" layoutX="270.0" layoutY="93.0" prefHeight="44.0" prefWidth="87.0" text="Label" AnchorPane.leftAnchor="100.0" AnchorPane.rightAnchor="100.0">
         <font>
            <Font name="Courier New" size="24.0" />
         </font></Label>
      <Label fx:id="errorMessageLabel" alignment="CENTER" layoutX="285.0" layoutY="149.0" AnchorPane.leftAnchor="75.0" AnchorPane.rightAnchor="75.0" />
   </children>
</AnchorPane>
