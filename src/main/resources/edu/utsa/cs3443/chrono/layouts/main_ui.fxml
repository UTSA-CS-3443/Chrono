<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="layoutPane" prefHeight="1024.0" prefWidth="1440.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.chrono.mainUI_Controller">

    <left>
        <VBox prefWidth="240.0" spacing="20.0" style="-fx-background-color: #193339;">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <children>
                <Label style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" text="Chrono" />

                <Button id="checklistButton" onAction="#goChecklist" style="-fx-text-fill: white; -fx-background-color: #193339;" text="Checklist" />
                <Button id="taskTimerButton" onAction="#goTimer" style="-fx-text-fill: white; -fx-background-color: #193339;" text="Task Timer" />
                <Button id="creatureButton" onAction="#goCreature" style="-fx-text-fill: white; -fx-background-color: #193339;" text="Creature" />
                <Button id="themesButton" onAction="#goThemes" style="-fx-text-fill: white; -fx-background-color: #193339;" text="Themes" />
                <Button id="storeButton" onAction="#goStore" style="-fx-text-fill: white; -fx-background-color: #668193;" text="Store" />
            </children>
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color: #364948;">
            <padding>
                <Insets left="20" />
            </padding>
            <children>
                <Label id="screenLabel" style="-fx-text-fill: white; -fx-font-size: 20;" text="Store" />
            </children>
        </HBox>
    </top>

    <center>
        <!-- filled dynamically -->
    </center>
    <right>

    </right>

</BorderPane>
